## Get latest from https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Visual Studio 2015/2017 cache/options directory
.vs/

# Local History for Visual Studio
.localhistory/

# Visual Studio History (VSHistory) files
.vshistory/

# VS Code files for those working on multiple tools
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Local History for Visual Studio Code
.history/

mgt2.zip

# Compiled LevelDB compendiums — rebuilt from packs/_source by `npm run compile`.
# Binary, renumbered on every build, and written to by Foundry merely opening them.
packs/*/
!packs/_source/

# Node
node_modules/
package-lock.json
.sass-cache/
