	"authors": [
		{
			"name": "JdR Ninja",
			"url": "https://www.jdr.ninja/",
			"discord": "jdr.ninja"
		}
	],
	"media": [
		{
			"type": "cover",
			"url": "https://raw.githubusercontent.com/JDR-Ninja/foundryvtt-mgt2/main/assets/screens/rosette-nebula-ngc2239-hoo.webp"
		},
		{
			"type": "screenshot",
			"url": "https://raw.githubusercontent.com/JDR-Ninja/foundryvtt-mgt2/main/web/foundryvtt/inventory.jpg",
			"caption": "Character sheet — inventory"
		}
	],
	"esmodules": [
		"src/module/core.js"
	],
	"styles": [
		{
			"src": "styles/mgt2.css",
			"layer": "system"
		}
	],
	"packs": [],
	"languages": [
		{
			"lang": "en",
			"name": "English",
			"path": "lang/en.json"
		},
		{
			"lang": "fr",
			"name": "Français",
			"path": "lang/fr.json"
		}
	],
	"documentTypes": {
		"Actor": {
			"character": {
				"htmlFields": [
					"biography",
					"notes",
					"personal.speciesText.descriptionLong"
				]
			},
			"npc": {
				"htmlFields": [
					"biography",
					"notes",
					"personal.speciesText.descriptionLong"
				],
				"gmOnlyFields": [
					"group"
				]
			},
			"vehicle": {
				"htmlFields": [
					"description",
					"notes"
				]
			},
			"spacecraft": {
				"htmlFields": [
					"description",
					"notes"
				],
				"gmOnlyFields": [
					"finance.purchase",
					"finance.mortgageOverride"
				]
			},
			"robot": {
				"htmlFields": [
					"description",
					"notes"
				]
			},
			"vehicule": {}
		},
		"Item": {
			"armor": {},
			"career": {},
			"computer": {},
			"contact": {
				"htmlFields": [
					"description",
					"notes"
				]
			},
			"container": {},
			"disease": {},
			"role": {},
			"equipment": {},
			"item": {},
			"species": {
				"htmlFields": [
					"descriptionLong"
				]
			},
			"talent": {},
			"weapon": {}
		}
	},
	"flags": {
		"hotReload": {
			"extensions": [
				"css",
				"html",
				"json"
			],
			"paths": [
				"styles",
				"templates",
				"lang"
			]
		}
	},
	"compatibility": {
		"minimum": "14",
		"verified": "14"
	},
	"grid": {
		"type": 1,
		"distance": 1.5,
		"units": "m",
		"diagonals": 0
	},
	"initiative": "2d6 + @initiative",
	"primaryTokenAttribute": "life"
}
