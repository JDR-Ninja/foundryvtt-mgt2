{
  "name": "foundryvtt-mgt2",
  "version": "0.2.0",
  "description": "Build tooling for the MGT2 - Mongoose Traveller (Unofficial) Foundry VTT system",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "sass src/sass/mgt2.sass styles/mgt2.css --no-source-map",
    "watch": "sass --watch src/sass/mgt2.sass styles/mgt2.css --no-source-map",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "sass": "^1.80.0"
  }
}
