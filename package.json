{
  "name": "foundryvtt-mgt2",
  "version": "0.2.0",
  "description": "Build tooling for the MGT2 - Mongoose Traveller (Unofficial) Foundry VTT system",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run styles && npm run docs && npm run compile",
    "styles": "sass src/sass/mgt2.sass styles/mgt2.css --no-source-map",
    "watch": "sass --watch src/sass/mgt2.sass styles/mgt2.css --no-source-map",
    "compile": "node tools/packs.mjs compile",
    "package": "npm run styles && npm run compile && node tools/package.mjs",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "docs": "node tools/coverage.mjs build",
    "docs:check": "node tools/coverage.mjs check",
    "packs": "node tools/packs.mjs list",
    "packs:extract": "node tools/packs.mjs extract",
    "validate": "node tools/packs.mjs validate"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "sass": "^1.80.0",
    "classic-level": "^3.0.0"
  }
}
